# ==================== Server ====================
APP_NAME=approval-flow
# development | production
ENV=development
LOG_LEVEL=debug
# Leave empty to log only to stdout (recommended in containers)
LOG_FILE_PATH=logs/approval-flow.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE=30
LOG_COMPRESS=true

SERVER_PORT=8080
GRPC_PORT=9090

# ==================== Infra ====================
# Override ALL of these in production (ENV=production refuses the default DB URL).
DATABASE_URL=postgres://aeroxe:secret@localhost:5432/approval-flow?sslmode=disable
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# ==================== Auth ====================
# REQUIRED. Must be at least 32 characters when ENV=production.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRY=24h

# Initial administrator account, created at startup if it does not exist.
# REQUIRED when ENV=production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ==================== Rate limiting ====================
# Per-IP fixed window: RateLimitRPS requests allowed per RateLimitWindow seconds.
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
RATE_LIMIT_WINDOW=60

# ==================== WebSocket ====================
WS_MAX_CONNECTIONS=1000
WS_PING_INTERVAL=30

# ==================== CORS ====================
# Comma-separated allow-list, e.g. https://app.example.com,https://admin.example.com
# Empty = "*" (development only; credentials are disabled with a wildcard).
CORS_ALLOWED_ORIGINS=

# ==================== Migrations / Docs ====================
# Directory containing golang-migrate SQL files (default ./migrations).
MIGRATIONS_PATH=./migrations
# Host advertised in the Swagger docs (default localhost:<port>).
SWAGGER_HOST=
