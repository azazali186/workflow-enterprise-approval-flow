# Base URL of the backend API (everything is exposed via POST /api/v1/...).
# In development, keep the relative path and let Vite proxy to the backend.
VITE_API_BASE_URL=/api/v1

# Backend origin used by the Vite dev-server proxy (development only).
VITE_API_PROXY_TARGET=http://localhost:8080

# Brand name shown in the UI.
VITE_APP_NAME=Approval Flow
